{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "name": {
      "type": "string",
      "minLength": 1
    },
    "schemaVersion": {
      "type": "number",
      "const": 1
    },
    "description": {
      "type": "string"
    },
    "service": {
      "type": "string",
      "enum": [
        "EMS",
        "PD",
        "FD"
      ]
    },
    "category": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "verified-source",
        "pending-validation",
        "disabled"
      ]
    },
    "provenance": {
      "type": "object",
      "properties": {
        "origin": {
          "type": "string",
          "enum": [
            "authorized-source",
            "user-import",
            "built-in",
            "roleplay"
          ]
        },
        "source": {
          "type": "string"
        },
        "sourceFile": {
          "type": "string"
        },
        "worksheet": {
          "type": "string"
        },
        "rows": {
          "type": "string"
        },
        "importedAt": {
          "type": "string"
        },
        "verifiedBy": {
          "type": "string"
        },
        "verifiedAt": {
          "type": "string"
        },
        "note": {
          "type": "string"
        }
      },
      "required": [
        "origin"
      ],
      "additionalProperties": false
    },
    "incomplete": {
      "type": "string"
    },
    "notes": {
      "type": "string"
    },
    "requiredFields": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "callerName",
          "callerPhone",
          "callerRelationship",
          "location",
          "complaint",
          "description",
          "personsInvolved",
          "patientName",
          "patientCount",
          "patientAge",
          "sex",
          "consciousStatus",
          "breathingStatus",
          "notes",
          "instructionsGiven"
        ]
      }
    },
    "start": {
      "type": "string",
      "minLength": 1
    },
    "nodes": {
      "minItems": 1,
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "question"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "prompt": {
                "type": "string",
                "minLength": 1
              },
              "help": {
                "type": "string"
              },
              "options": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "id": {
                      "type": "string",
                      "minLength": 1
                    },
                    "label": {
                      "type": "string",
                      "minLength": 1
                    },
                    "next": {
                      "type": "string",
                      "minLength": 1
                    },
                    "nextIf": {
                      "type": "array",
                      "items": {
                        "type": "object",
                        "properties": {
                          "node": {
                            "type": "string",
                            "minLength": 1
                          },
                          "option": {
                            "type": "string",
                            "minLength": 1
                          },
                          "next": {
                            "type": "string",
                            "minLength": 1
                          }
                        },
                        "required": [
                          "node",
                          "option",
                          "next"
                        ],
                        "additionalProperties": false
                      }
                    }
                  },
                  "required": [
                    "id",
                    "label",
                    "next"
                  ],
                  "additionalProperties": false
                }
              },
              "input": {
                "type": "object",
                "properties": {
                  "format": {
                    "type": "string",
                    "enum": [
                      "text",
                      "integer"
                    ]
                  }
                },
                "required": [
                  "format"
                ],
                "additionalProperties": false
              },
              "next": {
                "type": "string",
                "minLength": 1
              },
              "mandatory": {
                "type": "boolean"
              },
              "mandatoryIf": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string",
                    "minLength": 1
                  },
                  "anyOf": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  }
                },
                "required": [
                  "node",
                  "anyOf"
                ],
                "additionalProperties": false
              },
              "appliesIf": {
                "type": "object",
                "properties": {
                  "node": {
                    "type": "string",
                    "minLength": 1
                  },
                  "anyOf": {
                    "minItems": 1,
                    "type": "array",
                    "items": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "otherwise": {
                    "type": "string",
                    "minLength": 1
                  }
                },
                "required": [
                  "node",
                  "anyOf",
                  "otherwise"
                ],
                "additionalProperties": false
              },
              "rules": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "when": {
                      "type": "object",
                      "properties": {
                        "node": {
                          "type": "string",
                          "minLength": 1
                        },
                        "anyOf": {
                          "minItems": 1,
                          "type": "array",
                          "items": {
                            "type": "string",
                            "minLength": 1
                          }
                        }
                      },
                      "required": [
                        "node",
                        "anyOf"
                      ],
                      "additionalProperties": false
                    },
                    "forbid": {
                      "minItems": 1,
                      "type": "array",
                      "items": {
                        "type": "string",
                        "minLength": 1
                      }
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "when",
                    "forbid",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "unknownNext": {
                "type": "string",
                "minLength": 1
              },
              "unavailableNext": {
                "type": "string",
                "minLength": 1
              },
              "notAskedNext": {
                "type": "string",
                "minLength": 1
              },
              "field": {
                "type": "string",
                "enum": [
                  "callerName",
                  "callerPhone",
                  "callerRelationship",
                  "location",
                  "complaint",
                  "description",
                  "personsInvolved",
                  "patientName",
                  "patientCount",
                  "patientAge",
                  "sex",
                  "consciousStatus",
                  "breathingStatus",
                  "notes",
                  "instructionsGiven"
                ]
              },
              "checks": {
                "type": "array",
                "items": {
                  "type": "object",
                  "properties": {
                    "condition": {
                      "type": "string",
                      "minLength": 1
                    },
                    "message": {
                      "type": "string",
                      "minLength": 1
                    }
                  },
                  "required": [
                    "condition",
                    "message"
                  ],
                  "additionalProperties": false
                }
              },
              "stage": {
                "type": "string"
              },
              "sourceRef": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "prompt",
              "options"
            ],
            "additionalProperties": false
          },
          {
            "type": "object",
            "properties": {
              "kind": {
                "type": "string",
                "const": "terminal"
              },
              "id": {
                "type": "string",
                "minLength": 1
              },
              "outcome": {
                "type": "string",
                "minLength": 1
              },
              "help": {
                "type": "string"
              },
              "instruction": {
                "type": "string",
                "minLength": 1
              },
              "sourceRef": {
                "type": "string"
              }
            },
            "required": [
              "kind",
              "id",
              "outcome"
            ],
            "additionalProperties": false
          }
        ]
      }
    }
  },
  "required": [
    "id",
    "name",
    "schemaVersion",
    "start",
    "nodes"
  ],
  "additionalProperties": false
}
